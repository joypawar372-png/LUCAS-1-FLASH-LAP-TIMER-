#define OLED_SCL          22

// ============================================================================
// 2. TRACK & CALIBRATION CONSTANTS (6M TRACK OPTIMIZATION)
// ============================================================================
#define MAX_TRACK_CM      600   // 6-Meter (600 cm) maximum ceiling
#define JITTER_DEADBAND   4     // 4 cm dead zone to reject sensor noise at max range
#define VARIATION_CUT_CM  35    // Sudden drop in distance (cm) required to trigger cut
#define MIN_VALID_CM      6     // Ignore sub-6cm blindspot reflections
#define LOCKOUT_MS        2500  // 2.5-second lockout between start cut and finish cut
#define FINISH_HOLD_MS    10000 // Pause screen for 10 seconds after finishing lap
#define MAX_LAP_HISTORY   20    // Store up to 20 past laps in RAM

