// ============================================================================
// 6. NON-BLOCKING ACOUSTIC BUZZER ENGINE
// ============================================================================
void triggerBuzzerPattern(int pulses, int freq, unsigned long onMs, unsigned long offMs) {
  buzzerJob.active = true;
  buzzerJob.pulsesRemaining = pulses;
  buzzerJob.freq = freq;
  buzzerJob.onDuration = onMs;
  buzzerJob.offDuration = offMs;
  buzzerJob.lastToggleMs = millis();
  buzzerJob.toneState = true;
  tone(BUZZER_PIN, freq);
}

void serviceBuzzer() {
  if (!buzzerJob.active) return;
  unsigned long now = millis();

  if (buzzerJob.toneState) {
    if (now - buzzerJob.lastToggleMs >= buzzerJob.onDuration) {
      noTone(BUZZER_PIN);
      buzzerJob.toneState = false;
      buzzerJob.lastToggleMs = now;
      buzzerJob.pulsesRemaining--;
      if (buzzerJob.pulsesRemaining <= 0) {
        buzzerJob.active = false;
      }
    }
  } else {
    if (now - buzzerJob.lastToggleMs >= buzzerJob.offDuration) {
      tone(BUZZER_PIN, buzzerJob.freq);
      buzzerJob.toneState = true;
      buzzerJob.lastToggleMs = now;
    }
  }
}

// ============================================================================
// 7. 6-METER MAXIMUM RANGE CALIBRATION & CUT DETECTION ENGINE
// ============================================================================
void calibrateTrackMaximums() {
  display.clearDisplay();
  display.setTextSize(1);
  display.setCursor(0, 0);
  display.print("BRAVO X1 CALIBRATION");
  display.drawLine(0, 10, 127, 10, WHITE);
  display.setCursor(0, 22);
  display.print("Scanning 6M Track...");
  display.setCursor(0, 36);
  display.print("Keep Line Clear!");
  display.display();

  long sonarAccum = 0;
  int sonarValidCount = 0;
  long tofAccum = 0;
  int tofValidCount = 0;

  for (int i = 0; i < 16; i++) {
    // Read Ultrasonic (0 means out of range / open 6M space -> map to MAX_TRACK_CM)
    unsigned int s = sonar.ping_cm();
    if (s == 0) s = MAX_TRACK_CM;
    if (s >= MIN_VALID_CM) {
      sonarAccum += s;
      sonarValidCount++;
    }

    // Read VL53 ToF
    unsigned int t = 0;
    if (isVL53L1X && tof1.dataReady()) {
      t = tof1.read() / 10;
      if (tof1.timeoutOccurred() || t == 0) t = 400;
    } else if (isVL53L0X) {
      t = tof0.readRangeContinuousMillimeters() / 10;
      if (tof0.timeoutOccurred() || t == 0 || t > 250) t = 250;
    }
    if (t >= MIN_VALID_CM) {
      tofAccum += t;
      tofValidCount++;
    }

    int bar = map(i, 0, 15, 0, 128);
    display.fillRect(0, 52, bar, 8, WHITE);
    display.display();
    delay(45);
  }

  baseSonarCm = (sonarValidCount > 0) ? (sonarAccum / sonarValidCount) : MAX_TRACK_CM;
  baseTofCm   = (tofValidCount > 0)   ? (tofAccum / tofValidCount)     : 400;

  // Enforce minimum sensible baseline so close obstacles during boot don't lock out the gate
  if (baseSonarCm < 80) baseSonarCm = MAX_TRACK_CM;
  if (baseTofCm < 80)   baseTofCm   = 350;

  prevSonarCm = baseSonarCm;
  prevTofCm   = baseTofCm;

  triggerBuzzerPattern(2, 2200, 70, 50);
}

bool acquireSensorsAndDetectCut() {
  // 1. Poll Sonar (Map 0 "no echo" to MAX_TRACK_CM so open air is stable at 600cm)
  unsigned int rawS = sonar.ping_cm();
  int measuredS = (rawS == 0) ? MAX_TRACK_CM : (int)rawS;

  // Apply 4cm Deadzone Filter at max range to suppress measurement jitter
  if (abs(measuredS - prevSonarCm) <= JITTER_DEADBAND) {
    liveSonarCm = prevSonarCm;
  } else {
    liveSonarCm = measuredS;
    prevSonarCm = measuredS;
  }

  // 2. Poll ToF LiDAR
  int measuredT = prevTofCm;
  if (tofOnline) {
    if (isVL53L1X) {
      if (tof1.dataReady()) {
        int val = tof1.read() / 10;
        measuredT = (val <= 0 || val > 400) ? baseTofCm : val;
      }
    } else if (isVL53L0X) {
      int val = tof0.readRangeContinuousMillimeters() / 10;
      measuredT = (val <= 0 || val > 220) ? baseTofCm : val;
    }
  }

  // Apply 4cm Deadzone Filter to ToF
  if (abs(measuredT - prevTofCm) <= JITTER_DEADBAND) {
    liveTofCm = prevTofCm;
  } else {
    liveTofCm = measuredT;
    prevTofCm = measuredT;
  }

  // 3. Evaluate Large Distance Variation (Cut Trigger)
  // A cut happens when the distance drops sharply below baseline beyond the deadband
  int sonarDrop = baseSonarCm - liveSonarCm;
  bool sonarTriggered = (liveSonarCm >= MIN_VALID_CM) &&
                        (sonarDrop >= VARIATION_CUT_CM) &&
                        (sonarDrop > JITTER_DEADBAND);

  int tofDrop = baseTofCm - liveTofCm;
  bool tofTriggered = tofOnline &&
                      (liveTofCm >= MIN_VALID_CM) &&
                      (tofDrop >= VARIATION_CUT_CM) &&
                      (tofDrop > JITTER_DEADBAND);

  return (sonarTriggered || tofTriggered);
}

// ============================================================================
// 8. CAPACITIVE TOUCH SENSOR HANDLER (2-SEC HOLD & DOUBLE TAP)
// ============================================================================
void processTouchGestures() {
  bool isHigh = (digitalRead(TOUCH_PIN) == HIGH);
  unsigned long now = millis();

  if (isHigh) {
    if (!touchPressed) {
      touchPressed = true;
      holdTriggered = false;
      touchDownMs = now;
    } else {
      // Check if held continuously for 2000ms
      if (!holdTriggered && (now - touchDownMs >= 2000)) {
        holdTriggered = true;
        tapCounter = 0;

        if (currentState == STATE_HOME_STANDBY || currentState == STATE_PAST_LAPS) {
          // Activate Timer Gate Mode directly
          currentState = STATE_ARMED_GATE;
          lastCutTimeMs = now;
          triggerBuzzerPattern(1, 2000, 250, 50);
        } else {
          // Holding for 2s during active modes aborts back to Standby Home Menu
          currentState = STATE_HOME_STANDBY;
          triggerBuzzerPattern(1, 800, 300, 50);
        }
      }
    }
  } else {
    if (touchPressed) {
      unsigned long heldDuration = now - touchDownMs;
      touchPressed = false;

      // Register short tap if it wasn't a 2-second hold
      if (!holdTriggered && heldDuration >= 30 && heldDuration < 700) {
        tapCounter++;
        lastReleaseMs = now;
      }
    }

    // Evaluate completed tap sequences after 380ms window
    if (tapCounter > 0 && (now - lastReleaseMs >= 380)) {
      if (tapCounter >= 2) {
        // DOUBLE TAP: Toggle Past Laps Screen
        if (currentState == STATE_HOME_STANDBY) {
          currentState = STATE_PAST_LAPS;
          historyScrollOffset = 0;
          triggerBuzzerPattern(2, 1800, 50, 40);
        } else if (currentState == STATE_PAST_LAPS) {
          currentState = STATE_HOME_STANDBY;
          triggerBuzzerPattern(1, 1200, 80, 40);
        }
      } else if (tapCounter == 1) {
        // SINGLE TAP inside Past Laps: Scroll or Exit
        if (currentState == STATE_PAST_LAPS) {
          if (totalLapsLogged > 4 && (historyScrollOffset + 4 < totalLapsLogged)) {
            historyScrollOffset += 4;
          } else {
            currentState = STATE_HOME_STANDBY;
          }
          triggerBuzzerPattern(1, 1500, 40, 30);
        }
      }
      tapCounter = 0;
    }
  }
}

// ============================================================================
// 9. LAP RECORDING HELPER
// ============================================================================
void recordCompletedLap(double lapTimeSec) {
  if (lapTimeSec < bestLapSeconds) {
    bestLapSeconds = lapTimeSec;
  }

  if (totalLapsLogged < MAX_LAP_HISTORY) {
    lapMemory[totalLapsLogged] = lapTimeSec;
    totalLapsLogged++;
  } else {
    for (int i = 0; i < MAX_LAP_HISTORY - 1; i++) {
      lapMemory[i] = lapMemory[i + 1];
    }
    lapMemory[MAX_LAP_HISTORY - 1] = lapTimeSec;
  }
}

