// ==========================================
// PIN CONFIGURATIONS
// ==========================================
#define TOUCH_PIN     4
#define TRIG_PIN      5
#define ECHO_PIN      18
#define RED_LED       14
#define GREEN_LED     27
#define BUZZER_PIN    19

#define TOF_SDA       32
#define TOF_SCL       33
#define TOF_XSHUT     26

#define OLED_SDA      21
#define OLED_SCL      22
#define OLED_ADDR     0x3D // Fallback to 0x3C in code if needed

// ==========================================
// CONSTANTS & SENSOR TUNING
// ==========================================
#define MAX_SONAR_DIST_CM   400 // Pushed to HC-SR04 operational limit
#define JITTER_DEADBAND_CM  4   // 3-4 cm measurement noise rejection
#define BEAM_CUT_DELTA_CM   25  // Sudden distance drop indicating a skater
#define BEAM_CUT_MIN_CM     8   // Ignore readings closer than 8cm (sensor blindspot)
#define LOCKOUT_WINDOW_MS   2500 // Avoid double triggers from hands/feet/skates
#define MAX_STORED_LAPS     10

// ==========================================
// HARDWARE OBJECTS
// ==========================================
NewPing sonar(TRIG_PIN, ECHO_PIN, MAX_SONAR_DIST_CM);
Adafruit_SSD1306 display(128, 64, &Wire, -1);
VL53L1X tof1;
VL53L0X tof0;
AsyncWebServer server(80);
AsyncEventSource events("/events");

// ==========================================
// SYSTEM STATE ENUMS & VARIABLES
// ==========================================
enum SystemState {
  STATE_STANDBY,
  STATE_PAST_LAPS,
  STATE_COUNTDOWN,
  STATE_WAIT_START,
  STATE_TIMING,
  STATE_LAP_FINISHED
};

SystemState currentState = STATE_STANDBY;

// Sensor detection flags
bool isVL53L1X = false;
bool isVL53L0X = false;
bool tofReady = false;

// Calibration variables
int baselineSonarCm = 0;
int baselineTofCm = 0;

// High-precision timing
int64_t raceStartMicros = 0;
int64_t raceEndMicros = 0;
double currentLapSeconds = 0.0;
unsigned long stateTimerMillis = 0;
unsigned long lastTriggerTimeMillis = 0;

// Touch detection variables
unsigned long touchPressStartTime = 0;
unsigned long lastTapReleaseTime = 0;
int tapCount = 0;
bool touchWasPressed = false;

// Laps memory
double lapHistory[MAX_STORED_LAPS];
int totalLapsRecorded = 0;

// Web remote trigger flag
volatile bool remoteCountdownTriggered = false;

// Tone generator helper
void playTone(unsigned int freq, unsigned long durationMs) {
  tone(BUZZER_PIN, freq, durationMs);
  delay(durationMs);
  noTone(BUZZER_PIN);
}

// 5-beep sequence on lap completion
void playFinishBeeps() {
  for (int i = 0; i < 5; i++) {
    tone(BUZZER_PIN, 2600);
    digitalWrite(GREEN_LED, HIGH);
    digitalWrite(RED_LED, LOW);
    delay(70);
    noTone(BUZZER_PIN);
    digitalWrite(GREEN_LED, LOW);
    delay(50);
  }
}

// ==========================================
// HARDWARE SENSOR CALIBRATION & READING
// ==========================================
void calibrateBaselines() {
  display.clearDisplay();
  display.setTextSize(1);
  display.setCursor(5, 20);
  display.print("Calibrating Track...");
  display.setCursor(5, 40);
  display.print("Clear Finish Line");
  display.display();

  long sonarSum = 0;
  long tofSum = 0;
  int validSonarSamples = 0;
  int validTofSamples = 0;

  for (int i = 0; i < 15; i++) {
    int s = sonar.ping_cm();
    if (s > 0) {
      sonarSum += s;
      validSonarSamples++;
    }

    int t = 0;
    if (isVL53L1X && tof1.dataReady()) {
      t = tof1.read() / 10;
    } else if (isVL53L0X) {
      t = tof0.readRangeContinuousMillimeters() / 10;
    }
    if (t > 0 && t < 400) {
      tofSum += t;
      validTofSamples++;
    }
    delay(50);
  }

  baselineSonarCm = (validSonarSamples > 0) ? (sonarSum / validSonarSamples) : 300;
  baselineTofCm = (validTofSamples > 0) ? (tofSum / validTofSamples) : 200;

  Serial.printf("[CALIBRATION] Baseline Sonar: %d cm, Baseline ToF: %d cm\n", baselineSonarCm, baselineTofCm);
}

bool checkBeamCut(int &outSonar, int &outTof) {
  // 1. Read Ultrasonic
  outSonar = sonar.ping_cm();
  
  // 2. Read Time-of-Flight
  outTof = 0;
  if (isVL53L1X && tof1.dataReady()) {
    outTof = tof1.read() / 10;
  } else if (isVL53L0X) {
    outTof = tof0.readRangeContinuousMillimeters() / 10;
  }

  // Deadband jitter filter & large dynamic variation detection
  bool sonarCut = false;
  if (outSonar >= BEAM_CUT_MIN_CM && outSonar < (baselineSonarCm - BEAM_CUT_DELTA_CM)) {
    if (abs(outSonar - baselineSonarCm) > JITTER_DEADBAND_CM) {
      sonarCut = true;
    }
  }

  bool tofCut = false;
  if (tofReady && outTof >= BEAM_CUT_MIN_CM && outTof < (baselineTofCm - BEAM_CUT_DELTA_CM)) {
    if (abs(outTof - baselineTofCm) > JITTER_DEADBAND_CM) {
      tofCut = true;
    }
  }

  return (sonarCut || tofCut);
}

