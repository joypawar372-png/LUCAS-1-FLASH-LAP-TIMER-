// 10. WEB SERVER API HANDLERS
// ============================================================================
String getStateNameString() {
  switch (currentState) {
    case STATE_HOME_STANDBY: return "HOME STANDBY";
    case STATE_PAST_LAPS:    return "PAST LAPS";
    case STATE_COUNTDOWN:    return "COUNTDOWN 3-2-1";
    case STATE_ARMED_GATE:   return "ARMED (CROSS LINE)";
    case STATE_RUNNING:      return "TIMING LAP";
    case STATE_LAP_COMPLETE: return "LAP FINISHED (10S)";
    default:                 return "READY";
  }
}

String buildTelemetryJson() {
  double displayTime = 0.0;
  if (currentState == STATE_RUNNING) {
    displayTime = (double)(esp_timer_get_time() - startMicros) / 1000000.0;
  } else if (currentState == STATE_LAP_COMPLETE) {
    displayTime = activeLapSeconds;
  }

  char timeBuf[16];
  snprintf(timeBuf, sizeof(timeBuf), "%06.3f", displayTime);

  String json = "{";
  json += "\"state\":\"" + getStateNameString() + "\",";
  json += "\"time\":\"" + String(timeBuf) + "\",";
  json += "\"s\":" + String(liveSonarCm) + ",";
  json += "\"t\":" + String(liveTofCm) + ",";
  json += "\"bs\":" + String(baseSonarCm) + ",";
  json += "\"bt\":" + String(baseTofCm) + ",";
  json += "\"best\":" + String(bestLapSeconds, 3) + ",";
  json += "\"audio\":\"" + pendingWebAudioEvent + "\",";
  json += "\"laps\":[";
  for (int i = 0; i < totalLapsLogged; i++) {
    json += String(lapMemory[i], 3);
    if (i < totalLapsLogged - 1) json += ",";
  }
  json += "]}";

  // Clear one-shot audio event once dispatched to phone
  pendingWebAudioEvent = "NONE";
  return json;
}

void setupWebServer() {
  WiFi.mode(WIFI_AP);
  WiFi.softAP("BRAVO_X1_LUCAS", "12345678");
  Serial.print("[WIFI AP] Connect to 'BRAVO_X1_LUCAS', Open http://");
  Serial.println(WiFi.softAPIP());

  server.on("/", HTTP_GET, []() {
    server.send_P(200, "text/html", WEB_APP_HTML);
  });

  server.on("/status", HTTP_GET, []() {
    server.send(200, "application/json", buildTelemetryJson());
  });

  server.on("/cmd", HTTP_GET, []() {
    String act = server.arg("a");
    unsigned long now = millis();

    if (act == "remote_start") {
      // Trigger 3-2-1 Phone & Buzzer Countdown -> Starts Timer Immediately After 1!
      currentState = STATE_COUNTDOWN;
      stateStartTimeMs = now;
      lastCountdownBeepStep = -1;
    } 
    else if (act == "arm_gate") {
      // Arm Gate Mode -> Waits for player to cross line for the 1st time
      currentState = STATE_ARMED_GATE;
      lastCutTimeMs = now;
      triggerBuzzerPattern(1, 2000, 200, 50);
    } 
    else if (act == "calibrate") {
      calibrateTrackMaximums();
    } 
    else if (act == "reset") {
      currentState = STATE_HOME_STANDBY;
      triggerBuzzerPattern(1, 900, 150, 50);
    } 
    else if (act == "clear_laps") {
      totalLapsLogged = 0;
      bestLapSeconds = 999999.0;
    }

    server.send(200, "application/json", buildTelemetryJson());
  });

  server.begin();
}

// ============================================================================
// 11. OLED UI RENDERER
// ============================================================================
void renderOledScreen() {
  unsigned long now = millis();
  display.clearDisplay();
  display.setTextColor(WHITE);

  switch (currentState) {

    // ------------------------------------------------------------------------
    // HOME MENU (STANDBY)
    // ------------------------------------------------------------------------
    case STATE_HOME_STANDBY: {
      digitalWrite(RED_LED, HIGH);
      digitalWrite(GREEN_LED, LOW);

      display.setTextSize(1);
      display.setCursor(0, 0);
      display.print("BRAVO X1 | HOME MENU");
      display.drawLine(0, 10, 127, 10, WHITE);

      display.setCursor(0, 15);
      display.print("Hold 2s : ARM GATE");
      display.setCursor(0, 26);
      display.print("Dbl Tap : PAST LAPS");
      display.setCursor(0, 37);
      display.printf("S:%3dcm  ToF:%3dcm", liveSonarCm, liveTofCm);

      if (touchPressed) {
        unsigned long held = now - touchDownMs;
        int w = map(constrain(held, 0, 2000), 0, 2000, 0, 128);
        display.drawRect(0, 52, 128, 10, WHITE);
        display.fillRect(0, 52, w, 10, WHITE);
      } else {
        display.setCursor(0, 53);
        display.print("WiFi: 192.168.4.1");
      }
      break;
    }

    // ------------------------------------------------------------------------
    // PAST LAPS SCREEN
    // ------------------------------------------------------------------------
    case STATE_PAST_LAPS: {
      digitalWrite(RED_LED, LOW);
      digitalWrite(GREEN_LED, LOW);

      display.setTextSize(1);
      display.setCursor(0, 0);
      display.print("PAST LAPS (Tap=Exit)");
      display.drawLine(0, 10, 127, 10, WHITE);

      if (totalLapsLogged == 0) {
        display.setCursor(12, 30);
        display.print("No Laps Recorded");
      } else {
        for (int i = 0; i < 4; i++) {
          int idx = totalLapsLogged - 1 - (historyScrollOffset + i);
          if (idx >= 0 && idx < totalLapsLogged) {
            display.setCursor(0, 14 + (i * 12));
            display.printf("#%02d: %06.3f s", idx + 1, lapMemory[idx]);
            if ( fabs(lapMemory[idx] - bestLapSeconds) < 0.001 ) {
              display.print(" *BEST");
            }
          }
        }
      }
      break;
    }

    // ------------------------------------------------------------------------
    // REMOTE 3-2-1 COUNTDOWN
    // ------------------------------------------------------------------------
    case STATE_COUNTDOWN: {
      unsigned long elapsed = now - stateStartTimeMs;
      display.setTextSize(1);
      display.setCursor(12, 0);
      display.print("REMOTE PHONE START");
      display.drawLine(0, 10, 127, 10, WHITE);

      display.setTextSize(4);
      if (elapsed < 1000) {
        display.setCursor(52, 22);
        display.print("3");
      } else if (elapsed < 2000) {
        display.setCursor(52, 22);
        display.print("2");
      } else if (elapsed < 3000) {
        display.setCursor(52, 22);
        display.print("1");
      } else {
        display.setCursor(30, 22);
        display.print("GO!");
      }
      break;
    }

    // ------------------------------------------------------------------------
    // ARMED GATE (WAITING FOR FIRST LINE CROSSING)
    // ------------------------------------------------------------------------
    case STATE_ARMED_GATE: {
      digitalWrite(RED_LED, LOW);
      digitalWrite(GREEN_LED, HIGH);

      display.setTextSize(1);
      display.setCursor(0, 0);
      display.print("GATE ARMED | READY");
      display.drawLine(0, 10, 127, 10, WHITE);

      display.setTextSize(2);
      display.setCursor(4, 18);
      display.print("CROSS LINE");

      display.setTextSize(1);
      display.setCursor(0, 42);
      display.printf("Live S:%3d T:%3dcm", liveSonarCm, liveTofCm);
      display.setCursor(0, 54);
      display.printf("Base S:%3d T:%3dcm", baseSonarCm, baseTofCm);
      break;
    }

    // ------------------------------------------------------------------------
    // TIMING ACTIVE LAP
    // ------------------------------------------------------------------------
    case STATE_RUNNING: {
      digitalWrite(RED_LED, LOW);
      digitalWrite(GREEN_LED, (now / 250) % 2); // Flash Green LED while timing

      double liveSec = (double)(esp_timer_get_time() - startMicros) / 1000000.0;

      display.setTextSize(1);
      display.setCursor(0, 0);
      display.printf("LAP #%d IN PROGRESS", totalLapsLogged + 1);
      display.drawLine(0, 10, 127, 10, WHITE);

      display.setTextSize(3);
      display.setCursor(4, 20);
      display.printf("%06.2f", liveSec);

      display.setTextSize(1);
      display.setCursor(0, 52);
      display.printf("S:%3dcm   ToF:%3dcm", liveSonarCm, liveTofCm);
      break;
    }

    // ------------------------------------------------------------------------
    // LAP COMPLETED (10-SECOND HOLD)
    // ------------------------------------------------------------------------
    case STATE_LAP_COMPLETE: {
      digitalWrite(RED_LED, HIGH);
      digitalWrite(GREEN_LED, HIGH);

      unsigned long elapsed = now - stateStartTimeMs;
      int secLeft = max(0, 10 - (int)(elapsed / 1000));

      display.setTextSize(1);
      display.setCursor(0, 0);
      display.printf("LAP TIME  [Hold %ds]", secLeft);
      display.drawLine(0, 10, 127, 10, WHITE);

      display.setTextSize(3);
      display.setCursor(2, 18);
      display.printf("%06.3f", activeLapSeconds);

      display.setTextSize(1);
      display.setCursor(0, 48);
      if (fabs(activeLapSeconds - bestLapSeconds) < 0.001) {
        display.print(">> NEW BEST LAP! <<");
      } else {
        display.printf("Best: %06.3f s", bestLapSeconds);
      }

      // Visual 10-second countdown bar at bottom
      int barW = map(constrain(elapsed, 0, FINISH_HOLD_MS), 0, FINISH_HOLD_MS, 128, 0);
      display.fillRect(0, 59, barW, 5, WHITE);
      break;
    }
  }

  display.display();
}

// ============================================================================
// 12. ARDUINO SETUP
// ============================================================================
void setup() {
  Serial.begin(115200);
  delay(200);

  pinMode(TOUCH_PIN, INPUT);
  pinMode(RED_LED, OUTPUT);
  pinMode(GREEN_LED, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);

  digitalWrite(RED_LED, HIGH);
  digitalWrite(GREEN_LED, LOW);

  // 1. Hardware Reset VL53 ToF via XSHUT (GPIO 26) to prevent I2C bus lockup
  pinMode(TOF_XSHUT, OUTPUT);
  digitalWrite(TOF_XSHUT, LOW);
  delay(50);

  // 2. Initialize Primary I2C Bus for OLED (GPIO 21, 22)
  Wire.begin(OLED_SDA, OLED_SCL);
  if (display.begin(SSD1306_SWITCHCAPVCC, 0x3D)) {
    activeOledAddr = 0x3D;
  } else if (display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    activeOledAddr = 0x3C;
  }

  display.clearDisplay();
  display.setTextColor(WHITE);
  display.setTextSize(2);
  display.setCursor(16, 12);
  display.print("BRAVO X1");
  display.setTextSize(1);
  display.setCursor(14, 38);
  display.print("LUCAS SYSTEM V2");
  display.display();
  delay(800);

  // 3. Wake ToF Sensor and Initialize Secondary I2C Bus (GPIO 32, 33)
  digitalWrite(TOF_XSHUT, HIGH);
  delay(120);
  Wire1.begin(TOF_SDA, TOF_SCL, 100000); // 100kHz stable clock

  tof1.setBus(&Wire1);
  tof1.setTimeout(200);
  if (tof1.init()) {
    isVL53L1X = true;
    tofOnline = true;
    tof1.setDistanceMode(VL53L1X::Long);
    tof1.setMeasurementTimingBudget(33000);
    tof1.startContinuous(33);
  } else {
    tof0.setBus(&Wire1);
    tof0.setTimeout(200);
    if (tof0.init()) {
      isVL53L0X = true;
      tofOnline = true;
      tof0.startContinuous();
    }
  }

  // 4. Calibrate Track Maximums (6M Sonar + ToF)
  calibrateTrackMaximums();

  // 5. Start Wi-Fi AP & Embedded Mobile Web App
  setupWebServer();

  currentState = STATE_HOME_STANDBY;
}

// ============================================================================
// 13. MAIN DETERMINISTIC LOOP
// ============================================================================
void loop() {
  unsigned long now = millis();

  // Handle HTTP client requests, non-blocking buzzer, and touch gestures
  server.handleClient();
  serviceBuzzer();
  processTouchGestures();

  // Poll sensors and check if a high-variation beam cut occurred
  bool beamCutDetected = acquireSensorsAndDetectCut();

  // Execute State Machine Logic
  switch (currentState) {

    case STATE_HOME_STANDBY:
    case STATE_PAST_LAPS:
      // Idle states: sensors are updated for live telemetry preview
      break;

    case STATE_COUNTDOWN: {
      unsigned long elapsed = now - stateStartTimeMs;
      int step = elapsed / 1000; // 0="3", 1="2", 2="1", 3="GO!"

      if (step != lastCountdownBeepStep) {
        lastCountdownBeepStep = step;
        if (step >= 0 && step <= 2) {
          // 3... 2... 1... Beeps on Hardware Buzzer + Phone Speaker
          triggerBuzzerPattern(1, 900, 160, 40);
          pendingWebAudioEvent = "BEEP_COUNT";
        } else if (step == 3) {
          // GO! Beep + Immediately Start Lap Timer without crossing line!
          triggerBuzzerPattern(1, 2200, 500, 40);
          pendingWebAudioEvent = "BEEP_GO";
          startMicros = esp_timer_get_time();
          lastCutTimeMs = now; // Enforce 2.5s lockout so skater can accelerate
          currentState = STATE_RUNNING;
        }
      }
      break;
    }

    case STATE_ARMED_GATE: {
      // Waiting for Player to cut the box for the FIRST time
      if (beamCutDetected && (now - lastCutTimeMs >= 800)) {
        startMicros = esp_timer_get_time();
        lastCutTimeMs = now;

        // Single sharp beep when cut for the first time
        triggerBuzzerPattern(1, 2200, 180, 40);
        pendingWebAudioEvent = "BEEP_CUT1";

        currentState = STATE_RUNNING;
      }
      break;
    }

    case STATE_RUNNING: {
      // Player is on the track; wait for lockout window (2.5s) then detect FINISH cut
      if (beamCutDetected && (now - lastCutTimeMs >= LOCKOUT_MS)) {
        finishMicros = esp_timer_get_time();
        activeLapSeconds = (double)(finishMicros - startMicros) / 1000000.0;
        lastCutTimeMs = now;

        // Log lap into memory
        recordCompletedLap(activeLapSeconds);

        // Rapidly beep 5 times on Finish Line Cut!
        triggerBuzzerPattern(5, 2600, 75, 55);
        pendingWebAudioEvent = "BEEP_FINISH";

        // Transition to 10-Second Hold Screen
        stateStartTimeMs = now;
        currentState = STATE_LAP_COMPLETE;
      }
      break;
    }

    case STATE_LAP_COMPLETE: {
      // Hold the completed lap time on screen for 10 seconds, then return to Home Menu
      if (now - stateStartTimeMs >= FINISH_HOLD_MS) {
        currentState = STATE_HOME_STANDBY;
      }
      break;
    }
  }

  // Refresh OLED UI
  renderOledScreen();
}
