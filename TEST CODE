// Send Lap History as JSON via SSE
void broadcastLapsJSON() {
  String json = "[";
  for (int i = 0; i < totalLapsRecorded; i++) {
    json += String(lapHistory[i], 3);
    if (i < totalLapsRecorded - 1) json += ",";
  }
  json += "]";
  events.send(json.c_str(), "laps", millis());
}

// ==========================================
// TOUCH BUTTON HANDLER
// ==========================================
void handleTouchInputs() {
  bool isPressed = (digitalRead(TOUCH_PIN) == HIGH);
  unsigned long now = millis();

  if (isPressed && !touchWasPressed) {
    // Touch Just Pressed
    touchPressStartTime = now;
    touchWasPressed = true;
  } 
  else if (!isPressed && touchWasPressed) {
    // Touch Just Released
    unsigned long pressDuration = now - touchPressStartTime;
    touchWasPressed = false;

    if (pressDuration >= 2000) {
      // HOLD FOR 2 SECONDS CONFIRMED
      if (currentState == STATE_STANDBY || currentState == STATE_PAST_LAPS) {
        currentState = STATE_COUNTDOWN;
        stateTimerMillis = now;
        tapCount = 0;
      }
    } else if (pressDuration > 40 && pressDuration < 600) {
      // Possible Tap
      if (now - lastTapReleaseTime < 450) {
        tapCount++;
      } else {
        tapCount = 1;
      }
      lastTapReleaseTime = now;
    }
  }

  // Evaluate Tap Sequence
  if (tapCount > 0 && (now - lastTapReleaseTime >= 450) && !touchWasPressed) {
    if (tapCount == 2) {
      // DOUBLE TAP CONFIRMED
      if (currentState == STATE_STANDBY) {
        currentState = STATE_PAST_LAPS;
      } else if (currentState == STATE_PAST_LAPS) {
        currentState = STATE_STANDBY;
      }
    } else if (tapCount == 1 && currentState == STATE_PAST_LAPS) {
      currentState = STATE_STANDBY;
    }
    tapCount = 0;
  }
}

// ==========================================
// ARDUINO SETUP
// ==========================================
void setup() {
  Serial.begin(115200);

  pinMode(TOUCH_PIN, INPUT);
  pinMode(RED_LED, OUTPUT);
  pinMode(GREEN_LED, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(RED_LED, HIGH);
  digitalWrite(GREEN_LED, LOW);

  // Hardware Reset ToF on boot
  pinMode(TOF_XSHUT, OUTPUT);
  digitalWrite(TOF_XSHUT, LOW);

  // 1. OLED Display Setup
  Wire.begin(OLED_SDA, OLED_SCL);
  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR)) {
    display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  }
  display.setTextColor(WHITE);
  display.clearDisplay();
  display.setTextSize(2);
  display.setCursor(15, 20);
  display.print("BRAVO X1");
  display.setTextSize(1);
  display.setCursor(20, 45);
  display.print("Lucas Timing Sys");
  display.display();
  delay(1200);

  // 2. ToF Power Up
  digitalWrite(TOF_XSHUT, HIGH);
  delay(150);

  // 3. ToF Setup on Wire1
  Wire1.begin(TOF_SDA, TOF_SCL, 400000);
  tof1.setBus(&Wire1);
  tof1.setTimeout(250);
  if (tof1.init()) {
    isVL53L1X = true;
    tofReady = true;
    tof1.setDistanceMode(VL53L1X::Long);
    tof1.setMeasurementTimingBudget(33000);
    tof1.startContinuous(33);
  } else {
    tof0.setBus(&Wire1);
    tof0.setTimeout(250);
    if (tof0.init()) {
      isVL53L0X = true;
      tofReady = true;
      tof0.startContinuous();
    }
  }

  // 4. Wi-Fi Access Point Initialization
  WiFi.mode(WIFI_AP);
  WiFi.softAP("BRAVO_X1_TIMER", "bravox1speed");
  Serial.print("[AP READY] IP: ");
  Serial.println(WiFi.softAPIP());

  // 5. Async Web Server Setup
  server.on("/", HTTP_GET, [](AsyncWebServerRequest *request){
    request->send_P(200, "text/html", index_html);
  });

  server.on("/api/start_countdown", HTTP_GET, [](AsyncWebServerRequest *request){
    remoteCountdownTriggered = true;
    request->send(200, "text/plain", "COUNTDOWN_INITIATED");
  });

  events.onConnect([](AsyncEventSourceClient *client){
    client->send("Connected to BRAVO X1", "status", millis());
    broadcastLapsJSON();
  });
  server.addHandler(&events);
  server.begin();

  // Run dynamic track floor calibration
  calibrateBaselines();

  currentState = STATE_STANDBY;
}

// ==========================================
// MAIN REAL-TIME LOOP
// ==========================================
void loop() {
  unsigned long currentMillis = millis();
  handleTouchInputs();

  // Check remote web trigger
  if (remoteCountdownTriggered) {
    remoteCountdownTriggered = false;
    if (currentState == STATE_STANDBY || currentState == STATE_PAST_LAPS) {
      currentState = STATE_COUNTDOWN;
      stateTimerMillis = currentMillis;
    }
  }

  int currentSonarCm = 0;
  int currentTofCm = 0;

  // ==========================================
  // STATE MACHINE EXECUTION
  // ==========================================
  switch (currentState) {

    // ----------------------------------------------------
    // 1. STANDBY MENU
    // ----------------------------------------------------
    case STATE_STANDBY: {
      digitalWrite(RED_LED, HIGH);
      digitalWrite(GREEN_LED, LOW);
      noTone(BUZZER_PIN);

      // Drain ToF buffers
      if (isVL53L1X && tof1.dataReady()) tof1.read();
      if (isVL53L0X) tof0.readRangeContinuousMillimeters();

      display.clearDisplay();
      display.setTextSize(2);
      display.setCursor(15, 5);
      display.print("BRAVO X1");
      display.drawLine(0, 24, 127, 24, WHITE);

      display.setTextSize(1);
      display.setCursor(5, 30);
      display.print("Hold 2s : ARM TIMER");
      display.setCursor(5, 42);
      display.print("Dbl Tap : PAST LAPS");

      // Visual hold progress bar
      if (touchWasPressed) {
        unsigned long held = currentMillis - touchPressStartTime;
        int barW = map(constrain(held, 0, 2000), 0, 2000, 0, 128);
        display.fillRect(0, 56, barW, 8, WHITE);
      }
      display.display();

      events.send("STANDBY", "status", currentMillis);
      break;
    }

    // ----------------------------------------------------
    // 2. PAST LAPS HISTORY VIEW
    // ----------------------------------------------------
    case STATE_PAST_LAPS: {
      digitalWrite(RED_LED, LOW);
      digitalWrite(GREEN_LED, LOW);

      display.clearDisplay();
      display.setTextSize(1);
      display.setCursor(0, 0);
      display.print("PAST LAPS (Tap exit)");
      display.drawLine(0, 10, 127, 10, WHITE);

      if (totalLapsRecorded == 0) {
        display.setCursor(10, 30);
        display.print("No records logged.");
      } else {
        int displayCount = min(totalLapsRecorded, 4);
        for (int i = 0; i < displayCount; i++) {
          int lapIdx = totalLapsRecorded - 1 - i;
          display.setCursor(5, 14 + (i * 12));
          display.printf("L%d: %.3f s", lapIdx + 1, lapHistory[lapIdx]);
        }
      }
      display.display();
      events.send("VIEWING PAST LAPS", "status", currentMillis);
      break;
    }

    // ----------------------------------------------------
    // 3. 3-2-1 COUNTDOWN SEQUENCE
    // ----------------------------------------------------
    case STATE_COUNTDOWN: {
      unsigned long elapsed = currentMillis - stateTimerMillis;
      display.clearDisplay();
      display.setTextSize(4);

      if (elapsed < 1000) {
        display.setCursor(50, 18);
        display.print("3");
        display.display();
        digitalWrite(RED_LED, HIGH);
        playTone(800, 100);
        events.send("COUNTDOWN: 3", "status", currentMillis);
        events.send("low", "web_beep", currentMillis);
        delay(850);
      } 
      else if (elapsed < 2000) {
        display.setCursor(50, 18);
        display.print("2");
        display.display();
        digitalWrite(RED_LED, HIGH);
        playTone(800, 100);
        events.send("COUNTDOWN: 2", "status", currentMillis);
        events.send("low", "web_beep", currentMillis);
        delay(850);
      } 
      else if (elapsed < 3000) {
        display.setCursor(50, 18);
        display.print("1");
        display.display();
        digitalWrite(RED_LED, HIGH);
        playTone(800, 100);
        events.send("COUNTDOWN: 1", "status", currentMillis);
        events.send("low", "web_beep", currentMillis);
        delay(850);
      } 
      else {
        display.setCursor(35, 18);
        display.print("GO!");
        display.display();
        digitalWrite(RED_LED, LOW);
        digitalWrite(GREEN_LED, HIGH);
        playTone(1800, 400);
        events.send("GO! SYSTEM ARMED", "status", currentMillis);
        events.send("high", "web_beep", currentMillis);

        // Transition to waiting for the initial gate crossing
        currentState = STATE_WAIT_START;
        lastTriggerTimeMillis = millis();
      }
      break;
    }

    // ----------------------------------------------------
    // 4. ARMED: WAITING FOR FIRST LINE CROSSING
    // ----------------------------------------------------
    case STATE_WAIT_START: {
      digitalWrite(RED_LED, LOW);
      digitalWrite(GREEN_LED, HIGH);

      bool cut = checkBeamCut(currentSonarCm, currentTofCm);

      display.clearDisplay();
      display.setTextSize(1);
      display.setCursor(0, 0);
      display.print("BRAVO X1 : ARMED");
      display.drawLine(0, 10, 127, 10, WHITE);

      display.setTextSize(2);
      display.setCursor(10, 20);
      display.print("CROSS NOW");

      display.setTextSize(1);
      display.setCursor(0, 48);
      display.printf("S:%dcm T:%dcm", currentSonarCm, currentTofCm);
      display.display();

      events.send("WAITING FOR START CUT", "status", currentMillis);

      if (cut && (currentMillis - lastTriggerTimeMillis > LOCKOUT_WINDOW_MS)) {
        // Skater broke the beam for the first time
        raceStartMicros = esp_timer_get_time();
        lastTriggerTimeMillis = currentMillis;

        // Start beep confirmation
        tone(BUZZER_PIN, 2000, 120);

        currentState = STATE_TIMING;
      }
      break;
    }

    // ----------------------------------------------------
    // 5. TIMING ACTIVE LAP
    // ----------------------------------------------------
    case STATE_TIMING: {
      int64_t liveMicros = esp_timer_get_time() - raceStartMicros;
      currentLapSeconds = (double)liveMicros / 1000000.0;

      bool cut = checkBeamCut(currentSonarCm, currentTofCm);

      // Render Display
      display.clearDisplay();
      display.setTextSize(1);
      display.setCursor(0, 0);
      display.printf("LAP #%d TIMING", totalLapsRecorded + 1);
      display.drawLine(0, 10, 127, 10, WHITE);

      display.setTextSize(3);
      display.setCursor(0, 22);
      display.printf("%05.2f", currentLapSeconds);

      display.setTextSize(1);
      display.setCursor(100, 36);
      display.print("sec");

      display.setCursor(0, 54);
      display.printf("Rng: S:%d T:%d", currentSonarCm, currentTofCm);
      display.display();

      // Broadcast telemetry to phone
      char timeStr[16];
      snprintf(timeStr, sizeof(timeStr), "%.3f s", currentLapSeconds);
      events.send(timeStr, "timer", currentMillis);
      events.send("RUNNING", "status", currentMillis);

      // Check for Lap Completion
      if (cut && (currentMillis - lastTriggerTimeMillis > LOCKOUT_WINDOW_MS)) {
        raceEndMicros = esp_timer_get_time();
        currentLapSeconds = (double)(raceEndMicros - raceStartMicros) / 1000000.0;
        lastTriggerTimeMillis = currentMillis;

        // Store lap in history (circular buffer)
        if (totalLapsRecorded < MAX_STORED_LAPS) {
          lapHistory[totalLapsRecorded] = currentLapSeconds;
          totalLapsRecorded++;
        } else {
          for (int i = 0; i < MAX_STORED_LAPS - 1; i++) {
            lapHistory[i] = lapHistory[i + 1];
          }
          lapHistory[MAX_STORED_LAPS - 1] = currentLapSeconds;
        }

        // 5 rapid buzzer bursts
        playFinishBeeps();
        events.send("rapid_finish", "web_beep", currentMillis);
        broadcastLapsJSON();

        // Lock in completion display for 10 seconds
        stateTimerMillis = currentMillis;
        currentState = STATE_LAP_FINISHED;
      }
      break;
    }

    // ----------------------------------------------------
    // 6. FINISH SCREEN (PAUSES FOR EXACTLY 10 SECONDS)
    // ----------------------------------------------------
    case STATE_LAP_FINISHED: {
      digitalWrite(GREEN_LED, HIGH);
      digitalWrite(RED_LED, LOW);

      unsigned long elapsed = currentMillis - stateTimerMillis;
      int remainingSec = 10 - (elapsed / 1000);

      display.clearDisplay();
      display.setTextSize(1);
      display.setCursor(0, 0);
      display.print("LAP COMPLETED!");
      display.setCursor(95, 0);
      display.printf("[%ds]", max(0, remainingSec));
      display.drawLine(0, 10, 127, 10, WHITE);

      display.setTextSize(3);
      display.setCursor(0, 20);
      display.printf("%05.2f", currentLapSeconds);
      display.setTextSize(1);
      display.setCursor(100, 34);
      display.print("sec");

      display.setCursor(0, 52);
      display.print("Returning to Home...");
      display.display();

      char finalStr[16];
      snprintf(finalStr, sizeof(finalStr), "%.3f s", currentLapSeconds);
      events.send(finalStr, "timer", currentMillis);
      events.send("LAP FINISHED", "status", currentMillis);

      // Return to Standby Menu after 10 seconds
      if (elapsed >= 10000) {
        currentState = STATE_STANDBY;
      }
      break;
    }
  }

  delay(20);
}
